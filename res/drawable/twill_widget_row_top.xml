<?xml version="1.0" encoding="utf-8"?>
<!-- Twill widget: a list row card (surface bright) with its touch ripple clipped to it. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/twill_widget_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/twill_widget_card" />
            <corners android:topLeftRadius="20dp" android:topRightRadius="20dp" android:bottomLeftRadius="4dp" android:bottomRightRadius="4dp" />
        </shape>
    </item>
</ripple>
