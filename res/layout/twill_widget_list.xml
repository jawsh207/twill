<?xml version="1.0" encoding="utf-8"?>
<!-- Twill: "Conversations" widget. Every protocol's conversations, newest first, as rounded
     cards on the page colour like the app's settings and lists. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/twill_widget_background"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/twill_widget_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textColor="@color/twill_widget_on_surface"
                android:textSize="20sp" />

            <ImageView
                android:id="@+id/twill_widget_new_chat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/twill_widget_button"
                android:contentDescription="@string/widget_new_conversation_content_description"
                android:padding="11dp"
                android:src="@drawable/ic_start_chat"
                android:tint="@color/twill_widget_on_accent_container" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/twill_widget_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="3dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/twill_widget_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/twill_widget_empty"
                android:textColor="@color/twill_widget_on_surface_variant"
                android:textSize="14sp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
